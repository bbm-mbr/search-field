# ---- Model Farm (OpenAI-compatible gateway) ----
MODEL_FARM_BASE_URL=https://modelfarm.internal.bosch.com/v1
MODEL_FARM_API_KEY=replace-me
# Deep analysis / synthesis model (long-context reasoning)
ANALYSIS_MODEL=claude-sonnet-4-5
# Cheap fast model for extraction, classification, dedup
UTILITY_MODEL=claude-haiku-4-5
# Embedding model exposed by the farm (else local bge-small is used)
EMBEDDING_MODEL=text-embedding-3-large

# ---- Search providers (all free tiers / key-less) ----
# ddg needs no key. Optional extras:
SEARXNG_BASE_URL=            # self-hosted SearXNG instance (best corporate option)
BRAVE_SEARCH_API_KEY=        # free tier: 2,000 queries/month
TAVILY_API_KEY=              # free tier: 1,000 credits/month

# ---- App ----
PLAYBOOK_DIR=./playbook      # drop the Search-Field playbook PDF(s) here
CHROMA_DIR=./.chroma
CORS_ORIGINS=http://localhost:5173
